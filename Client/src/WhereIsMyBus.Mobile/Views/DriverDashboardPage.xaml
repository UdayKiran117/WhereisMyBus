<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:contracts="clr-namespace:WhereIsMyBus.Mobile.Core.Interfaces;assembly=WhereIsMyBus.Mobile.Core"
    x:Class="WhereIsMyBus.Mobile.Views.DriverDashboardPage"
    Title="Driver Dashboard"
    BackgroundColor="#F4F7FC"
    Shell.BackgroundColor="#102347"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White">

    <ContentPage.Resources>

        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="1.8" />
            <Setter Property="TextColor" Value="#7B8BA5" />
        </Style>

        <Style x:Key="FieldTitle" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#172B4D" />
        </Style>

        <Style x:Key="SelectionField" TargetType="Border">
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="BackgroundColor" Value="#F6F8FC" />
            <Setter Property="Stroke" Value="#E3EAF4" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="16" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Picker">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextColor" Value="#172B4D" />
            <Setter Property="TitleColor" Value="#8290A6" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="MinimumHeightRequest" Value="54" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="WidthRequest" Value="34" />
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="#EAF1FF" />
            <Setter Property="VerticalOptions" Value="Start" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="11" />
                </Setter.Value>
            </Setter>
        </Style>

    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="20,22,20,32"
            Spacing="22"
            MaximumWidthRequest="640"
            HorizontalOptions="Fill">

            <!-- Page introduction -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                <VerticalStackLayout Spacing="5">
                    <Label
                        Text="WHERE IS MY BUS"
                        Style="{StaticResource SectionLabel}" />

                    <Label
                        Text="Your next journey"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#102347" />
                </VerticalStackLayout>

                <Border
                    Grid.Column="1"
                    WidthRequest="48"
                    HeightRequest="48"
                    Padding="0"
                    BackgroundColor="White"
                    Stroke="#E3EAF4"
                    StrokeShape="RoundRectangle 16"
                    VerticalOptions="Center">

                    <Label
                        Text="BUS"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="#2864E8"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />
                </Border>
            </Grid>

            <!-- Driver identity card -->
            <Border
                Padding="22"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 26">

                <Border.Background>
                    <LinearGradientBrush
                        StartPoint="0,0"
                        EndPoint="1,1">
                        <GradientStop Color="#102347" Offset="0" />
                        <GradientStop Color="#204F9D" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Shadow>
                    <Shadow
                        Brush="#102347"
                        Offset="0,8"
                        Radius="18"
                        Opacity="0.16" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="DRIVER PROFILE"
                            FontSize="11"
                            FontAttributes="Bold"
                            CharacterSpacing="2"
                            TextColor="#ADC6EF"
                            VerticalOptions="Center" />

                        <Border
                            Grid.Column="1"
                            Padding="10,5"
                            BackgroundColor="#24FFFFFF"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 9">
                            <Label
                                Text="DRIVER"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1"
                                TextColor="White" />
                        </Border>
                    </Grid>

                    <Grid
                        ColumnDefinitions="56,*"
                        ColumnSpacing="15">

                        <Border
                            HeightRequest="56"
                            WidthRequest="56"
                            Padding="0"
                            BackgroundColor="#24FFFFFF"
                            Stroke="#40FFFFFF"
                            StrokeShape="RoundRectangle 18">

                            <!-- Person icon drawn without an external asset -->
                            <Grid
                                WidthRequest="30"
                                HeightRequest="34"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">

                                <Ellipse
                                    WidthRequest="12"
                                    HeightRequest="12"
                                    Fill="White"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Start" />

                                <Border
                                    Margin="0,16,0,0"
                                    HeightRequest="16"
                                    WidthRequest="26"
                                    BackgroundColor="White"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10,10,3,3"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Start" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                x:Name="DriverNameLabel"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="White"
                                LineBreakMode="WordWrap" />

                            <Label
                                x:Name="DriverMobileLabel"
                                FontSize="15"
                                TextColor="#C2D5F4" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="#30FFFFFF" />

                    <Label
                        Text="Choose your bus. Set your destination."
                        FontSize="14"
                        TextColor="#D7E5FB" />
                </VerticalStackLayout>
            </Border>

            <!-- Trip setup card -->
            <Border
                Padding="22"
                BackgroundColor="White"
                Stroke="#E7EDF6"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 26">

                <Border.Shadow>
                    <Shadow
                        Brush="#19345C"
                        Offset="0,5"
                        Radius="16"
                        Opacity="0.05" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="24">

                    <VerticalStackLayout Spacing="7">
                        <Label
                            Text="TRIP SETUP"
                            Style="{StaticResource SectionLabel}" />

                        <Label
                            Text="Ready when you are"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="#102347" />

                        <Label
                            Text="Complete the two steps below to check in."
                            FontSize="14"
                            TextColor="#73829A"
                            LineHeight="1.2" />
                    </VerticalStackLayout>

                    <!-- Step 1 -->
                    <Grid
                        ColumnDefinitions="34,*"
                        ColumnSpacing="12">

                        <Border Style="{StaticResource StepBadge}">
                            <Label
                                Text="1"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#2864E8"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="10">

                            <Label
                                Text="Select your bus"
                                Style="{StaticResource FieldTitle}"
                                Margin="0,6,0,0" />

                            <Border Style="{StaticResource SelectionField}">
                                <Picker
                                    x:Name="BusPicker"
                                    Title="Bus registration number"
                                    ItemDisplayBinding="{Binding RegistrationNumber,
                                        x:DataType=contracts:DashboardBus}"
                                    SelectedIndexChanged="OnBusChanged"
                                    SemanticProperties.Description="Select your assigned bus registration number" />
                            </Border>

                            <Label
                                Text="Choose from your assigned buses."
                                FontSize="12"
                                TextColor="#8290A6" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Step 2 -->
                    <Grid
                        ColumnDefinitions="34,*"
                        ColumnSpacing="12">

                        <Border
                            Style="{StaticResource StepBadge}"
                            BackgroundColor="#E7F7F1">
                            <Label
                                Text="2"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#0B9265"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="10">

                            <Label
                                Text="Choose destination"
                                Style="{StaticResource FieldTitle}"
                                Margin="0,6,0,0" />

                            <Border Style="{StaticResource SelectionField}">
                                <Picker
                                    x:Name="DestinationPicker"
                                    Title="Where are you heading?"
                                    IsEnabled="False"
                                    ItemDisplayBinding="{Binding Name,
                                        x:DataType=contracts:DashboardDestination}"
                                    SemanticProperties.Description="Select the destination for your trip" />
                            </Border>

                            <Label
                                Text="Destinations appear after selecting a bus."
                                FontSize="12"
                                TextColor="#8290A6" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="#EDF1F7" />

                    <!-- Loading and feedback -->
                    <ActivityIndicator
                        x:Name="BusyIndicator"
                        IsVisible="False"
                        IsRunning="False"
                        Color="#2864E8"
                        HeightRequest="28"
                        HorizontalOptions="Center" />

                    <Label
                        x:Name="StatusLabel"
                        IsVisible="False"
                        FontSize="14"
                        LineHeight="1.25"
                        TextColor="#64748B"
                        HorizontalTextAlignment="Center" />

                    <!-- Primary action -->
                    <Button
                        x:Name="CheckInButton"
                        Text="Check In / Start Trip"
                        Clicked="OnCheckInClicked"
                        IsEnabled="False"
                        BackgroundColor="#0A9568"
                        TextColor="White"
                        FontSize="17"
                        FontAttributes="Bold"
                        CornerRadius="17"
                        MinimumHeightRequest="58"
                        Padding="16,12">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter
                                            Property="BackgroundColor"
                                            Value="#0A9568" />
                                        <Setter
                                            Property="TextColor"
                                            Value="White" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter
                                            Property="BackgroundColor"
                                            Value="#087A55" />
                                    </VisualState.Setters>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter
                                            Property="BackgroundColor"
                                            Value="#E5EBF3" />
                                        <Setter
                                            Property="TextColor"
                                            Value="#8A99AF" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Button>

                    <Button
                        x:Name="RetryButton"
                        Text="Refresh assigned buses"
                        Clicked="OnReloadClicked"
                        BackgroundColor="Transparent"
                        TextColor="#2864E8"
                        FontSize="14"
                        FontAttributes="Bold"
                        MinimumHeightRequest="48"
                        CornerRadius="12"
                        Padding="12,8" />

                </VerticalStackLayout>
            </Border>

            <Label
                Text="Please complete trip setup while safely parked."
                FontSize="12"
                TextColor="#8290A6"
                HorizontalTextAlignment="Center"
                Margin="12,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>