<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:WhereIsMyBus.Mobile.Core.ViewModels;assembly=WhereIsMyBus.Mobile.Core"
    xmlns:models="clr-namespace:WhereIsMyBus.Mobile.Core.Models;assembly=WhereIsMyBus.Mobile.Core"
    x:Class="WhereIsMyBus.Mobile.Views.SearchPage"
    x:DataType="vm:SearchViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}">
    <Shell.TitleView>
        <Grid HorizontalOptions="Fill">
            <Label
                Text="Where Is My Bus"
                FontSize="20"
                FontAttributes="Bold"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center"
                VerticalTextAlignment="Center" />
        </Grid>
    </Shell.TitleView>
    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- ───────── Palette ───────── -->
            <Color x:Key="PageLight">#F3F5F9</Color>
            <Color x:Key="PageDark">#0B1020</Color>
            <Color x:Key="SurfaceLight">#FFFFFF</Color>
            <Color x:Key="SurfaceDark">#161D33</Color>
            <Color x:Key="FieldLight">#F3F5F9</Color>
            <Color x:Key="FieldDark">#0F1529</Color>
            <Color x:Key="LineLight">#E3E7EF</Color>
            <Color x:Key="LineDark">#2A3352</Color>
            <Color x:Key="InkLight">#0E1730</Color>
            <Color x:Key="InkDark">#F2F5FF</Color>
            <Color x:Key="MutedLight">#5B6785</Color>
            <Color x:Key="MutedDark">#9AA6C4</Color>
            <Color x:Key="Brand">#0866F5</Color>
            <Color x:Key="BrandSoft">#82B5FF</Color>
            <Color x:Key="Go">#007B50</Color>

            <!-- ───────── Text ───────── -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style x:Key="Muted" TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="1.25" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                <Setter Property="Margin" Value="2,0,0,0" />
            </Style>

            <!-- ───────── Surfaces ───────── -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Padding" Value="18" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="22" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#0E1730" Opacity="0.08" Radius="18" Offset="0,6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Rounded shell that wraps Entry / Picker for a consistent, borderless-looking input -->
            <Style x:Key="FieldShell" TargetType="Border">
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="MinimumHeightRequest" Value="52" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="14" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#9AA3B8, Dark=#6C7796}" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="MinimumHeightRequest" Value="52" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="TitleColor" Value="{AppThemeBinding Light=#9AA3B8, Dark=#6C7796}" />
            </Style>

            <!-- ───────── Buttons ───────── -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="MinimumHeightRequest" Value="52" />
                <Setter Property="Padding" Value="20,0" />
            </Style>

            <Style x:Key="GoButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="BackgroundColor" Value="{StaticResource Go}" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandSoft}}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="Padding" Value="8,0" />
            </Style>

            <!-- Language chips sit on the dark hero -->
            <Style x:Key="LangChip" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#26FFFFFF" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="BorderColor" Value="#33FFFFFF" />
                <Setter Property="BorderWidth" Value="1" />
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <!-- Full-bleed column: hero first, then a centered, width-capped content column -->
        <VerticalStackLayout Spacing="0">

            <!-- ═════════ HERO ═════════ -->
            <!-- Full-width bus image -->
            <Border
    Padding="0"
    Margin="0"
    StrokeThickness="0"
    HorizontalOptions="Fill">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,32,32" />
                </Border.StrokeShape>

                <Grid
        HeightRequest="260"
        HorizontalOptions="Fill"
        IsClippedToBounds="True">

                    <Image
            Source="bus.png"
            Aspect="AspectFill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

                    <!-- Shading keeps the title readable -->
                    <BoxView InputTransparent="True">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#D90A1630" Offset="0" />
                                <GradientStop Color="#800A1630" Offset="0.35" />
                                <GradientStop Color="#000A1630" Offset="0.75" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <VerticalStackLayout
    Margin="20,26,20,0"
    Spacing="10"
    HorizontalOptions="Center"
    VerticalOptions="Start"
    InputTransparent="True">

                        <Label
        Text="Where Is My Bus"
        TextColor="White"
        FontSize="32"
        FontAttributes="Bold"
        CharacterSpacing="0.5"
        HorizontalTextAlignment="Center">

                            <Label.Shadow>
                                <Shadow
                Brush="Black"
                Offset="0,3"
                Radius="10"
                Opacity="0.9" />
                            </Label.Shadow>
                        </Label>

                        <!-- Gold accent beneath the title -->
                        <Border
        WidthRequest="64"
        HeightRequest="4"
        Padding="0"
        StrokeThickness="0"
        BackgroundColor="#FFD166"
        HorizontalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="2" />
                            </Border.StrokeShape>

                            <Border.Shadow>
                                <Shadow
                Brush="#FFD166"
                Offset="0,1"
                Radius="8"
                Opacity="0.65" />
                            </Border.Shadow>
                        </Border>

                    </VerticalStackLayout>

                </Grid>
            </Border>

            <!-- ═════════ CONTENT COLUMN ═════════ -->
            <VerticalStackLayout
                Padding="16,0,16,32"
                Spacing="16"
                Margin="0,-22,0,0"
                HorizontalOptions="Center"
                MaximumWidthRequest="640">

                <!-- Search by registration number -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label
                            Text="{Binding NumberLabel}"
                            Style="{StaticResource FieldLabel}" />

                        <!-- Wraps to two rows on very narrow screens, one row otherwise -->
                        <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Stretch">
                            <Border
                                Style="{StaticResource FieldShell}"
                                FlexLayout.Grow="3"
                                FlexLayout.Basis="200"
                                Margin="0,0,10,10">
                                <Entry
                                    Text="{Binding RegistrationNumber}"
                                    Placeholder="TS09AB1234"
                                    MaxLength="30"
                                    Keyboard="Plain"
                                    ReturnType="Search"
                                    ReturnCommand="{Binding SearchCommand}"
                                    SemanticProperties.Description="{Binding NumberLabel}" />
                            </Border>

                            <Button
                                Text="{Binding SearchLabel}"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource PrimaryButton}"
                                FlexLayout.Grow="1"
                                FlexLayout.Basis="130"
                                Margin="0,0,0,10" />
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
                <!-- Nearby stations using passenger GPS -->
                <VerticalStackLayout Spacing="10" Margin="0,8,0,16">

                    <Label
        Text="Nearby bus stations"
        FontSize="17"
        FontAttributes="Bold" />

                    <Label
        Text="Use your location to find a boarding point near you."
        Style="{StaticResource Muted}" />

                    <Button
        x:Name="NearbyStationsButton"
        Text="Find nearby stations"
        Clicked="OnNearbyStationsClicked"
        Style="{StaticResource PrimaryButton}" />

                    <ActivityIndicator
        x:Name="NearbyStationsLoading"
        IsRunning="False"
        IsVisible="False"
        Color="{StaticResource Brand}" />

                    <Label
        x:Name="NearbyStationsMessage"
        IsVisible="False"
        Style="{StaticResource Muted}" />

                    <VerticalStackLayout
        x:Name="NearbyStationsList"
        Spacing="8">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                    Padding="14"
                    Style="{StaticResource FieldShell}">

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Label
                            Text="{Binding Name}"
                            FontSize="15"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                                        <Label
                            Grid.Column="1"
                            Text="{Binding DistanceText}"
                            TextColor="{StaticResource Brand}"
                            FontSize="13"
                            VerticalOptions="Center" />
                                    </Grid>

                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
                <!-- Search by route -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">

                        <!-- From / To sit side-by-side on wide screens, stack on phones -->
                        <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Start">

                            <VerticalStackLayout
                                Spacing="6"
                                FlexLayout.Grow="1"
                                FlexLayout.Basis="240"
                                Margin="0,0,10,12">
                                <Label
                                    Text="{Binding FromLabel}"
                                    Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldShell}">
                                    <Picker
                                        Title="{Binding FromLabel}"
                                        ItemsSource="{Binding Locations}"
                                        ItemDisplayBinding="{Binding Name, x:DataType=models:LocationModel}"
                                        SelectedItem="{Binding FromLocation}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                Spacing="6"
                                FlexLayout.Grow="1"
                                FlexLayout.Basis="240"
                                Margin="0,0,0,12">
                                <Label
                                    Text="{Binding ToLabel}"
                                    Style="{StaticResource FieldLabel}" />
                                <Border Style="{StaticResource FieldShell}">
                                    <Picker
                                        Title="{Binding ToLabel}"
                                        ItemsSource="{Binding Locations}"
                                        ItemDisplayBinding="{Binding Name, x:DataType=models:LocationModel}"
                                        SelectedItem="{Binding ToLocation}" />
                                </Border>
                            </VerticalStackLayout>
                        </FlexLayout>

                        <Button
                            Text="{Binding RouteLabel}"
                            Command="{Binding SearchRouteCommand}"
                            Style="{StaticResource GoButton}" />

                        <Button
                            Text="{Binding RetryLabel}"
                            Command="{Binding LoadLocationsCommand}"
                            Style="{StaticResource GhostButton}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Status -->
                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource Brand}"
                    HeightRequest="32"
                    WidthRequest="32" />

                <VerticalStackLayout Spacing="4" Padding="4,0">
                    <Label
                        Text="{Binding Message}"
                        FontSize="16"
                        FontAttributes="Bold"
                        SemanticProperties.Description="{Binding Message}" />

                    <Label
                        Text="{Binding Hint}"
                        Style="{StaticResource Muted}" />
                </VerticalStackLayout>

                <!-- Results -->
                <VerticalStackLayout
                    BindableLayout.ItemsSource="{Binding Buses}"
                    Spacing="12">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:BusModel">
                            <Border Style="{StaticResource Card}" Padding="0">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
        Command="{Binding OpenBusCommand,
            Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}},
            x:DataType=vm:SearchViewModel}"
        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="6,*">

                                    <!-- Accent edge -->
                                    <BoxView
                Color="{StaticResource Brand}"
                WidthRequest="6" />

                                    <VerticalStackLayout
                Grid.Column="1"
                Padding="16,14,16,16"
                Spacing="8">

                                        <!-- Plate-style registration -->
                                        <Border
                    HorizontalOptions="Start"
                    Padding="12,6"
                    StrokeThickness="1.5"
                    Stroke="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
                    BackgroundColor="{AppThemeBinding Light=#FFF8D6, Dark=#2A2610}">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>

                                            <Label
                        Text="{Binding RegistrationNumber}"
                        FontSize="20"
                        FontAttributes="Bold"
                        CharacterSpacing="1" />
                                        </Border>

                                        <Label
                    Text="{Binding OperatorName}"
                    FontSize="16"
                    FontAttributes="Bold" />

                                        <Label
                    Text="{Binding DisplayName}"
                    Style="{StaticResource Muted}" />

                                        <!-- Status pill -->
                                        <Border
                    HorizontalOptions="Start"
                    Padding="10,5"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFF1DC, Dark=#3A2A10}">

                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="999" />
                                            </Border.StrokeShape>

                                            <Label
                        Text="{Binding TrackingLabel,
                            Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}},
                            x:DataType=vm:SearchViewModel}"
                        TextColor="{AppThemeBinding Light=#9A4B00, Dark=#FFC46B}"
                        FontSize="13"
                        FontAttributes="Bold" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
